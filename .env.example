# GitHub knowledge repository access. Defaults to the real public knowledge base —
# override to point at your own fork instead.
GITHUB_REPO=pocket-nutrition/knowledge

# Optional — a public repo can be read without a token. Only needed to raise the
# GitHub API rate limit.
GITHUB_TOKEN=CHANGE_ME

# Stores
REDIS_URL=redis://redis:6379/2
DATABASE_URL=postgresql://pocket_nutrition:CHANGE_ME@postgresql:5432/pocket_nutrition

# Admin endpoint auth — REQUIRED in production, do not keep the default
RELOAD_TOKEN=CHANGE_ME

# Downstream API
API_URL=http://openfood-api:8080
